{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        "meta": {
          ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
          ".validate": "newData.hasChildren(['host','state','game'])"
        },
        "rounds": {
          ".write": "auth != null && root.child('rooms/'+$code+'/meta/host').val() === auth.uid"
        },
        "players": {
          "$u": {
            ".write": "auth != null && auth.uid === $u && (data.exists() || (root.child('rooms/'+$code+'/meta/state').val() === 'lobby' && root.child('rooms/'+$code+'/players').numChildren() < 10))",
            ".validate": "newData.hasChildren(['name','av'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 14" },
            "av": { ".validate": "newData.isString() && newData.val().length <= 8" },
            "online": { ".validate": "newData.isBoolean()" },
            "joined": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "scores": {
          "$g": {
            "$u": {
              ".write": "auth != null && auth.uid === $u",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() - (data.exists() ? data.val() : 0) >= 0 && newData.val() - (data.exists() ? data.val() : 0) <= 400"
            }
          }
        },
        "answers": {
          "$g": {
            "$r": {
              "$u": {
                ".write": "auth != null && auth.uid === $u && !data.exists()",
                ".validate": "newData.hasChildren(['ok','pts']) && newData.child('pts').val() <= 400"
              }
            }
          }
        }
      }
    }
  }
}
